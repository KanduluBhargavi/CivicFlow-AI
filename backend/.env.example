DATABASE_URL=postgresql://postgres:password@localhost:5432/civicflow
SECRET_KEY=change-me
ALGORITHM=HS256

# Optional official Google Cloud Translation API key (kept server-side).
# If blank, CivicFlow uses Google Translate Web plus its GoogleTranslator fallback.
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_TIMEOUT_SECONDS=10
GOOGLE_TRANSLATE_MAX_RETRIES=2

# Free Google Translate web fallback (no API key required).
FREE_GOOGLE_TRANSLATE_TIMEOUT_SECONDS=8
FREE_GOOGLE_TRANSLATE_MAX_RETRIES=2
ENABLE_UNOFFICIAL_TRANSLATION_FALLBACK=true

# BHASHINI / ULCA (required for Bodo, which is not in Google's published
# Cloud Translation language list). Keep the key and user ID server-side.
# The pipeline must support the source language -> English pair, e.g. brx -> en.
BHASHINI_PIPELINE_ID=
BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
# Optional compute URL override; normally taken from the pipeline config response.
BHASHINI_TRANSLATION_URL=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_TIMEOUT_SECONDS=10

# MyMemory sends text to a separate public service; leave disabled unless approved.
ENABLE_MYMEMORY_TRANSLATION_FALLBACK=false

# Email verification and password-reset OTP security.
# Existing CivicFlow email notifications already use SMTP_EMAIL/SMTP_PASSWORD.
SMTP_EMAIL=your-gmail-or-smtp-account@example.com
SMTP_PASSWORD=your-app-password
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Set true only for local debugging; never use this in production.
OTP_DEV_MODE=false
